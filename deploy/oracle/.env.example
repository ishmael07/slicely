# Copy to .env next to compose.yml. Everything here is the SERVER's, never a
# visitor's — visitors paste their own key in the app. Details: docs/DEPLOY-ORACLE.md

# The public hostname Caddy serves, without https://  (e.g. slicely.duckdns.org)
SLICELY_HOST=
# The same origin WITH https://  — every sign-in redirect is built from it
SLICELY_PUBLIC_URL=

# Required. Encrypts every visitor's pasted key at rest. Generate ONCE:
#   node scripts/gen-master-key.mjs
# and never reuse across deployments; losing it makes stored keys undecryptable.
SLICELY_MASTER_KEY=

# Optional sourcing keys — omit any and that source degrades, nothing fails.
THINGIVERSE_APP_TOKEN=
GITHUB_TOKEN=
MYMINIFACTORY_API_KEY=
SMITHSONIAN_API_KEY=

# Optional: sign-in + free credit. All three groups or accounts stay off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# YOUR key(s) — they fund the 50¢ credit, spendable only by signed-in accounts
# under the daily cap. Never spent by a stranger with no account.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
