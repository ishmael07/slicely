{
  "name": "slicely",
  "version": "0.1.0",
  "description": "Slicely — an AI agent that finds free 3D-printable models online and drives PrusaSlicer for you. macOS chat-bar app.",
  "main": "dist/main/main.js",
  "author": "ishmael07",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron dist/main/main.js",
    "dev": "npm run build && electron dist/main/main.js",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:only": "node --test \"dist/**/*.test.js\"",
    "serve": "npm run build && node dist/server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.105.0",
    "bonjour-service": "^1.4.4",
    "cheerio": "^1.2.0",
    "dotenv": "17.4.2",
    "express": "^4.22.2",
    "mqtt": "^5.15.2",
    "multer": "^2.3.0",
    "unzipper": "0.12.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "20.19.9",
    "@types/unzipper": "0.10.11",
    "@types/ws": "^8.18.1",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "dev.ishmael.slicely",
    "productName": "Slicely",
    "files": [
      "dist/**/*",
      "dist-web/**/*",
      "src/web/*.html",
      "src/web/*.css",
      "site/terms.html",
      "site/privacy.html",
      "site/favicon.svg",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ]
    }
  }
}
