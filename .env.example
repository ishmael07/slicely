# Slicely — SERVER configuration. Copy to `.env` and edit.
#
# Everything in this file belongs to whoever RUNS Slicely. None of it is a
# visitor's credential, and none of it is ever sent to a browser.
#
# The key that pays for chat is NOT here: each user pastes their own Anthropic
# key into Settings, it is encrypted per session with SLICELY_MASTER_KEY below,
# and their own Anthropic account is billed. See README → "Bring your own key".
# The one exception — YOUR own key, as a fallback for a server you are paying
# for yourself — is at the bottom, with the warning it needs.

# ── mode ─────────────────────────────────────────────────────────────────────
# "hosted" (the default, and what `npm run serve` and Docker use) = a shared
#   server anyone can reach: `__Host-` session cookie, LAN printer discovery and
#   LAN-only transports refused (a datacenter's network is not the visitor's),
#   and no filesystem access outside a session's own workspace.
# "desktop" = the Electron app on one person's own machine, which sets this
#   itself. There is no third value, and no separate multi-user switch: the mode
#   IS the switch (src/main/mode.ts).
SLICELY_MODE=hosted

# ── secrets ──────────────────────────────────────────────────────────────────
# Encrypts each session's stored Anthropic key at rest (AES-256-GCM). REQUIRED
# in hosted mode. 32 bytes, base64: `openssl rand -base64 32`.
# Rotating it makes every stored key unreadable — users simply reconnect.
# Desktop derives its own into the app's userData directory instead.
SLICELY_MASTER_KEY=

# ── where files live ─────────────────────────────────────────────────────────
# Uploads, downloads and sliced G-code, one directory per session beneath it.
# On Fly this is the mounted volume (/data); keep it off the ephemeral disk.
SLICELY_WORKDIR=~/Slicely-data

# ── PrusaSlicer ──────────────────────────────────────────────────────────────
PRUSASLICER_PATH=/Applications/PrusaSlicer.app/Contents/MacOS/PrusaSlicer
# Your exported printer/filament config, for estimates that match the machine:
# PrusaSlicer → File → Export → Export Config…
PRUSASLICER_CONFIG_INI=
# How many slices may run at once. Each one saturates a core; the rest queue,
# and a request that arrives behind a full queue is told "busy" rather than
# being held open until a proxy times it out.
SLICELY_MAX_SLICES=2

# ── serving ──────────────────────────────────────────────────────────────────
SLICELY_PORT=3000
# Set to 1 ONLY behind a reverse proxy you control. It makes X-Forwarded-For
# trusted, and BOTH the per-IP rate limits and the session-mint cap depend on
# that address being honest — with no proxy in front, any caller could then hand
# itself a fresh bucket per request.
SLICELY_TRUST_PROXY=0
# Where the site footer's and Settings → About source link points. AGPL §13:
# running PrusaSlicer as a network service obliges you to offer the source of
# what is running. See src/server/LICENSING.md.
SLICELY_REPO_URL=

# ── model sourcing (owner's keys, optional) ──────────────────────────────────
# Raise rate limits / unlock search on the model sites. Never sent to a visitor,
# never reachable from the browser client. Search degrades, it does not break,
# when one is missing.
THINGIVERSE_APP_TOKEN=
GITHUB_TOKEN=
MYMINIFACTORY_API_KEY=
SMITHSONIAN_API_KEY=
# Re-enable the scraped sources (Thangs / Yeggi / STLFinder). They are
# bot-blocked in practice and added ~8s to every search, so they are off.
SLICELY_ENABLE_SCRAPERS=

# ── defaults for the agent ───────────────────────────────────────────────────
# Both are only DEFAULTS; the in-app picker overrides and persists per session.
SLICELY_MODEL=
SLICELY_EFFORT=

# ── the operator's own Anthropic key ─────────────────────────────────────────
# ⚠️  READ THIS BEFORE SETTING SLICELY_ALLOW_OPERATOR_KEY.
#
# Chat is bring-your-own-key: each visitor pastes their own Anthropic key and
# their own account is billed. ANTHROPIC_API_KEY below is YOURS, and Slicely
# falls back to it only when:
#
#   • you are running the desktop app (you are the only user), or
#   • you set SLICELY_ALLOW_OPERATOR_KEY=1 (and nothing else — "true"/"yes"
#     do not count).
#
# On a server the public can reach, that flag means EVERY VISITOR'S CHAT IS
# BILLED TO YOU, with no per-user limit and no warning to them beyond a hint
# that reads "this server's key". Anyone who finds the URL can spend your
# credit. Leave it unset unless the server is private or you intend to pay.
#
# A hosted server IGNORES ANTHROPIC_API_KEY without the flag, so a key that is
# in this file for some other tool is not quietly spent on strangers.
ANTHROPIC_API_KEY=
# SLICELY_ALLOW_OPERATOR_KEY=1
